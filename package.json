{
  "name": "@rbxts/type-fest",
  "version": "5.10.0",
  "packageManager": "npm@11.19.0",
  "description": "Type-Fest types for roblox-ts",
  "scripts": {
    "sync": "tsx scripts/sync.ts",
    "verify": "tsc -p tsconfig.tools.json && tsx --test tests/*.test.ts && tsx scripts/verify.ts",
    "prepublishOnly": "npm run verify",
    "release": "tsx scripts/release.ts",
    "prepare:bootstrap": "tsx scripts/sync.ts --prepare-bootstrap"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "1.0.805",
    "@types/node": "22.5.4",
    "@types/semver": "7.7.1",
    "roblox-ts": "3.0.0",
    "semver": "7.7.3",
    "tsx": "4.20.6",
    "typescript": "5.5.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/studiorafa/rbxts-type-fest"
  },
  "dependencies": {
    "tagged-tag": "1.0.0"
  }
}
